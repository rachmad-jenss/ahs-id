{
  "name": "@ahs-id/ahsp-dcktrp-by-source",
  "version": "0.1.0",
  "description": "AHSP fixed-coefficient per dasar hukum — derived from portal Bangun Jakarta HSP",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "node ../../scripts/clean.mjs dist .turbo *.tsbuildinfo"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rachmad-jenss/ahs-id.git",
    "directory": "packages/ahsp-dcktrp-by-source"
  },
  "publishConfig": {
    "access": "public"
  }
}
