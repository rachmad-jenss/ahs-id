{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahs-id.dev/schemas/bahan-master.schema.json",
  "title": "BahanMasterBundle",
  "type": "object",
  "required": ["version", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kode", "nama", "satuan"],
        "additionalProperties": false,
        "properties": {
          "kode": { "type": "string", "pattern": "^M\\." },
          "nama": { "type": "string", "minLength": 1 },
          "satuan": { "type": "string", "minLength": 1 },
          "kategori": { "type": "string" }
        }
      }
    }
  }
}
