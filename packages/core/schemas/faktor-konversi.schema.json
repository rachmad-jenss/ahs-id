{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahs-id.dev/schemas/faktor-konversi.schema.json",
  "title": "FaktorKonversi",
  "type": "object",
  "required": ["version", "derivation_rule", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "derivation_rule": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["material", "bank_to_loose", "bank_to_compacted", "berat_jenis_bank_ton_m3"],
        "additionalProperties": false,
        "properties": {
          "material": { "type": "string", "minLength": 1 },
          "bank_to_loose": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
          "bank_to_compacted": { "type": ["number", "null"], "maximum": 2 },
          "berat_jenis_bank_ton_m3": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 }
        }
      }
    }
  }
}
