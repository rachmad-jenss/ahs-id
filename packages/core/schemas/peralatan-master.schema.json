{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahs-id.dev/schemas/peralatan-master.schema.json",
  "title": "PeralatanMasterBundle",
  "type": "object",
  "required": ["version", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kode", "nama", "tipe_default", "daya_hp", "berat_operasi_ton", "tipe_produksi", "hsd_params", "produktivitas_params"],
        "properties": {
          "kode": { "type": "string", "pattern": "^E\\." },
          "nama": { "type": "string", "minLength": 1 },
          "tipe_default": { "type": "string", "minLength": 1 },
          "daya_hp": { "type": "number", "minimum": 0, "maximum": 2000 },
          "berat_operasi_ton": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 },
          "tipe_produksi": { "type": "string", "enum": ["siklus", "lintasan", "throughput"] },
          "kapasitas_bucket_m3": { "type": "number", "exclusiveMinimum": 0 },
          "kapasitas_ton": { "type": "number", "exclusiveMinimum": 0 },
          "kapasitas_m3": { "type": "number", "exclusiveMinimum": 0 },
          "lebar_drum_m": { "type": "number", "exclusiveMinimum": 0 },
          "hsd_params": { "$ref": "#/$defs/hsd_params" },
          "produktivitas_params": {
            "type": "object",
            "required": ["volume_state_output"],
            "properties": {
              "volume_state_output": {
                "type": ["string", "null"],
                "enum": ["bank", "loose", "compacted", null]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pelumas_entry": {
      "type": "object",
      "required": ["cp", "satuan"],
      "properties": {
        "cp": { "type": "number", "minimum": 0, "maximum": 1 },
        "satuan": { "type": "string" },
        "basis": { "type": "string", "enum": ["berat_operasi"] }
      }
    },
    "hsd_params": {
      "type": "object",
      "required": [
        "harga_pokok_rp", "umur_ekonomis_tahun", "jam_kerja_per_tahun",
        "nilai_sisa_pct", "faktor_angsuran", "asuransi_pajak_pct",
        "bahan_bakar_ch", "pelumas", "perawatan_pct", "perbaikan_pct", "fpr"
      ],
      "additionalProperties": false,
      "properties": {
        "harga_pokok_rp": { "type": "number", "exclusiveMinimum": 0 },
        "umur_ekonomis_tahun": { "type": "integer", "minimum": 1, "maximum": 30 },
        "jam_kerja_per_tahun": { "type": "integer", "minimum": 500, "maximum": 4000 },
        "nilai_sisa_pct": { "type": "number", "minimum": 0.03, "maximum": 0.10 },
        "faktor_angsuran": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "asuransi_pajak_pct": { "type": "number", "minimum": 0, "maximum": 0.10 },
        "bahan_bakar_ch": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "pelumas": {
          "type": "object",
          "required": ["mesin", "hidrolik", "grease"],
          "additionalProperties": false,
          "properties": {
            "mesin": { "$ref": "#/$defs/pelumas_entry" },
            "hidrolik": { "$ref": "#/$defs/pelumas_entry" },
            "grease": { "$ref": "#/$defs/pelumas_entry" }
          }
        },
        "perawatan_pct": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "perbaikan_pct": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "fpr": {
          "type": "object",
          "required": ["normal", "berat", "default"],
          "additionalProperties": false,
          "properties": {
            "normal": { "type": "number", "minimum": 0.5, "maximum": 2 },
            "berat": { "type": "number", "minimum": 0.5, "maximum": 3 },
            "sangat_berat": { "type": "number", "minimum": 0.5, "maximum": 4 },
            "default": { "type": "string", "enum": ["normal", "berat", "sangat_berat"] },
            "catatan": { "type": "string" }
          }
        }
      }
    }
  }
}
