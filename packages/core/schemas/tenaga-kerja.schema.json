{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ahs-id.dev/schemas/tenaga-kerja.schema.json",
  "title": "TenagaKerjaBundle",
  "type": "object",
  "required": ["version", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kode", "nama", "satuan", "kualifikasi", "jam_kerja_nominal", "jam_efektif"],
        "additionalProperties": false,
        "properties": {
          "kode": { "type": "string", "pattern": "^L\\." },
          "nama": { "type": "string", "minLength": 1 },
          "satuan": { "const": "OH" },
          "kualifikasi": {
            "type": "string",
            "enum": ["non-terampil", "terampil", "terampil-senior", "pengawas", "operator", "semi-terampil"]
          },
          "rumpun": { "type": "string", "pattern": "^L\\." },
          "jam_kerja_nominal": { "type": "integer", "minimum": 1, "maximum": 24 },
          "jam_efektif": { "type": "integer", "minimum": 1, "maximum": 24 }
        }
      }
    }
  }
}
