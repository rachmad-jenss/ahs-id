{
  "name": "@ahs-id/cli",
  "version": "0.1.0",
  "description": "CLI for AHS-ID — AHSP calculation, RAB export, and bundle validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ahs-id": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@ahs-id/core": "workspace:*",
    "@ahs-id/pupr-2023": "workspace:*",
    "@ahs-id/bina-marga-2016": "workspace:*",
    "@ahs-id/bina-marga-2022": "workspace:*",
    "@ahs-id/cipta-karya-2024": "workspace:*",
    "@ahs-id/hsd-kaltim-2025": "workspace:*",
    "@ahs-id/hsd-jabar-2025": "workspace:*",
    "@ahs-id/hsd-papua-2025": "workspace:*",
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
