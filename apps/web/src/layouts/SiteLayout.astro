---
import { ChevronDown, Monitor, Moon, Sun } from 'lucide-react';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'AHS-ID — Data AHSP dan engine perhitungan Indonesia',
  description = 'Jelajahi data AHSP Indonesia yang terstruktur, terbuka, dan dapat ditelusuri sumbernya.',
  canonical,
} = Astro.props;
const currentPath = Astro.url.pathname;
const resolvedCanonical = canonical ?? new URL(currentPath, Astro.site ?? 'https://ahs-id.jenss.me').toString();

const navItems = [
  { href: '/katalog/', label: 'Katalog' },
  { href: '/kalkulator/', label: 'Kalkulator' },
  { href: '/bundles/', label: 'Bundel' },
  { href: '/docs/', label: 'Dokumentasi' },
  { href: '/metodologi/', label: 'Metodologi' },
  { href: '/tentang/', label: 'Tentang' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7ee" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AHS-ID" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/ahs-id-mark.png" type="image/png" sizes="128x128" />
    <link rel="apple-touch-icon" href="/ahs-id-mark.png" />
    <link rel="canonical" href={resolvedCanonical} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storageKey = 'ahs-id-theme';
        let storedTheme = 'system';
        try {
          const candidate = window.localStorage.getItem(storageKey);
          if (candidate === 'light' || candidate === 'dark') storedTheme = candidate;
        } catch {
          // Private browsing and blocked storage should keep the system default.
        }
        document.documentElement.dataset.theme = storedTheme;
        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) {
          themeColor.setAttribute('content', storedTheme === 'dark' || (storedTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches) ? '#1d2924' : '#faf7ee');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Langsung ke konten utama</a>
    <header class="safe-area-header sticky top-0 z-40 border-b border-border/80 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
      <div class="safe-area-inline mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-5 lg:px-8">
        <a class="inline-flex items-center" href="/" aria-label="AHS-ID, beranda">
          <span class="theme-logo relative inline-flex h-8 w-16 shrink-0 items-center">
            <img class="theme-logo-light h-full w-full object-contain" src="/ahs-id-logo.png" alt="AHS-ID" width="160" height="80" />
            <img class="theme-logo-dark absolute inset-0 h-full w-full object-contain" src="/ahs-id-logo-dark.png" alt="" aria-hidden="true" width="160" height="80" />
          </span>
        </a>

        <div class="flex items-center gap-2">
          <nav class="hidden items-center gap-5 md:flex" aria-label="Navigasi utama">
            {navItems.map((item) => (
              <a
                class:list={[
                  'pressable inline-flex min-h-11 items-center text-sm transition-colors hover-fine-text-primary',
                  currentPath.startsWith(item.href) ? 'font-semibold text-primary' : 'text-muted-foreground',
                ]}
                aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
                href={item.href}
              >
                {item.label}
              </a>
            ))}
            <a class="pressable inline-flex min-h-11 w-11 items-center justify-center text-muted-foreground transition-colors hover-fine-text-primary" href="https://github.com/rachmad-jenss/ahs-id" rel="noreferrer" aria-label="GitHub" title="GitHub">
              <svg aria-hidden="true" class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.09.682-.217.682-.483 0-.237-.009-.866-.014-1.7-2.782.604-3.369-1.342-3.369-1.342-.455-1.157-1.11-1.465-1.11-1.465-.908-.621.069-.608.069-.608 1.004.07 1.532 1.03 1.532 1.03.892 1.529 2.341 1.088 2.91.832.091-.647.349-1.088.635-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.682-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0 1 12 6.844a9.56 9.56 0 0 1 2.504.337c1.909-1.294 2.748-1.025 2.748-1.025.546 1.377.202 2.394.1 2.647.64.698 1.028 1.591 1.028 2.682 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.744 0 .268.18.578.688.48A10.001 10.001 0 0 0 22 12c0-5.523-4.477-10-10-10Z" />
              </svg>
            </a>
          </nav>

          <button class="pressable inline-flex min-h-11 w-11 items-center justify-center text-muted-foreground transition-colors hover-fine-text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" id="theme-toggle" type="button" aria-label="Tema tampilan: Sistem" title="Tema tampilan: Sistem">
            <span class="grid h-5 w-5 place-items-center" aria-hidden="true">
              <Monitor className="theme-icon h-5 w-5" data-theme-icon="system" data-theme-active="true" />
              <Sun className="theme-icon h-5 w-5" data-theme-icon="light" data-theme-active="false" />
              <Moon className="theme-icon h-5 w-5" data-theme-icon="dark" data-theme-active="false" />
            </span>
            <span class="sr-only" id="theme-toggle-label">Tema tampilan: Sistem</span>
          </button>

          <details class="group relative md:hidden">
            <summary class="pressable flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border border-border px-4 text-sm font-semibold marker:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
              Menu <ChevronDown aria-hidden="true" className="disclosure-chevron h-4 w-4 transition-transform duration-150 group-open:rotate-180" />
            </summary>
            <nav class="mobile-menu-panel absolute right-0 top-14 w-56 rounded-2xl border border-border bg-card p-2 shadow-xl" aria-label="Navigasi mobile">
              {navItems.map((item) => (
                <a
                  class:list={[
                    'pressable flex min-h-11 items-center rounded-xl px-3 py-2 text-sm text-foreground hover-fine-bg-muted',
                    currentPath.startsWith(item.href) ? 'bg-muted font-semibold' : '',
                  ]}
                  aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
                  href={item.href}
                >{item.label}</a>
              ))}
              <a class="pressable flex min-h-11 items-center rounded-xl px-3 py-2 text-sm text-foreground hover-fine-bg-muted" href="https://github.com/rachmad-jenss/ahs-id" rel="noreferrer">GitHub</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main class="safe-area-main" id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="border-t border-border/80">
      <div class="safe-area-inline mx-auto grid max-w-7xl gap-10 px-5 py-12 lg:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
        <div>
          <span class="theme-logo relative inline-flex h-8 w-16 items-center" aria-hidden="true">
            <img class="theme-logo-light h-full w-full object-contain" src="/ahs-id-logo.png" alt="" width="160" height="80" />
            <img class="theme-logo-dark absolute inset-0 h-full w-full object-contain" src="/ahs-id-logo-dark.png" alt="" width="160" height="80" />
          </span>
          <div class="mt-3 font-serif text-xl">AHS-ID</div>
          <p class="mt-3 max-w-sm text-sm leading-6 text-muted-foreground">Engine perhitungan dan bundel data AHSP Indonesia yang terbuka, terstruktur, dan dapat diaudit.</p>
        </div>
        <div>
          <p class="text-sm font-semibold text-foreground">Jelajahi</p>
          <div class="mt-4 grid gap-3 text-sm">
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/katalog/">Katalog AHSP</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/bundles/">Bundel Data</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/metodologi/">Sumber dan Metodologi</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/metodologi/#se47-nasional">Pipeline SE 47 (nasional)</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/tentang/">Tentang AHS-ID</a>
          </div>
        </div>
        <div>
          <p class="text-sm font-semibold text-foreground">Dibuat untuk Developer</p>
          <div class="mt-4 grid gap-3 text-sm">
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/docs/">Quick Start NPM</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="https://github.com/rachmad-jenss/ahs-id" rel="noreferrer">Kode Sumber di GitHub</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="https://www.npmjs.com/org/ahs-id" rel="noreferrer">Paket di NPM</a>
          </div>
        </div>
      </div>
      <div class="safe-area-footer safe-area-inline mx-auto flex max-w-7xl flex-col gap-2 border-t border-border/60 px-5 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between lg:px-8">
        <span>MIT License · © 2026 AHS-ID</span>
        <span>Verifikasi data regulasi dengan sumber resmi sebelum digunakan.</span>
      </div>
    </footer>
    <script>
      const storageKey = 'ahs-id-theme';
      const root = document.documentElement;
      const themeToggle = document.getElementById('theme-toggle');
      const themeColor = document.querySelector('meta[name="theme-color"]');
      const systemPreference = window.matchMedia('(prefers-color-scheme: dark)');
      const themeOrder = ['system', 'light', 'dark'] as const;
      const themeNames = { system: 'Sistem', light: 'Terang', dark: 'Gelap' } as const;

      function updateThemeColor(theme: string): void {
        if (!themeColor) return;
        const isDark = theme === 'dark' || (theme === 'system' && systemPreference.matches);
        themeColor.setAttribute('content', isDark ? '#1d2924' : '#faf7ee');
      }

      function syncThemeControl(theme: (typeof themeOrder)[number]): void {
        if (!(themeToggle instanceof HTMLButtonElement)) return;
        const label = `Tema tampilan: ${themeNames[theme]}`;
        themeToggle.setAttribute('aria-label', label);
        themeToggle.setAttribute('title', label);
        const hiddenLabel = themeToggle.querySelector('#theme-toggle-label');
        if (hiddenLabel) hiddenLabel.textContent = label;
        themeToggle.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((icon) => {
          icon.dataset.themeActive = icon.dataset.themeIcon === theme ? 'true' : 'false';
        });
      }

      function setTheme(nextTheme: (typeof themeOrder)[number]): void {
        root.dataset.themeSwitching = 'true';
        root.dataset.theme = nextTheme;
        try {
          if (nextTheme === 'system') window.localStorage.removeItem(storageKey);
          else window.localStorage.setItem(storageKey, nextTheme);
        } catch {
          // The visual choice still works when storage is unavailable.
        }
        updateThemeColor(nextTheme);
        syncThemeControl(nextTheme);
        window.requestAnimationFrame(() => window.requestAnimationFrame(() => root.removeAttribute('data-theme-switching')));
      }

      const currentTheme = root.dataset.theme === 'light' || root.dataset.theme === 'dark' ? root.dataset.theme : 'system';
      syncThemeControl(currentTheme);
      themeToggle?.addEventListener('click', () => {
        const activeTheme = root.dataset.theme === 'light' || root.dataset.theme === 'dark' ? root.dataset.theme : 'system';
        const nextTheme = themeOrder[(themeOrder.indexOf(activeTheme) + 1) % themeOrder.length] ?? 'system';
        setTheme(nextTheme);
      });

      systemPreference.addEventListener('change', () => {
        if (root.dataset.theme === 'system') updateThemeColor('system');
      });
    </script>
  </body>
</html>
