---
import { ChevronDown } from 'lucide-react';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'AHS-ID — Data AHSP dan engine perhitungan Indonesia',
  description = 'Jelajahi data AHSP Indonesia yang terstruktur, terbuka, dan dapat ditelusuri sumbernya.',
  canonical,
} = Astro.props;
const currentPath = Astro.url.pathname;
const resolvedCanonical = canonical ?? new URL(currentPath, Astro.site ?? 'https://ahs-id.jenss.me').toString();

const navItems = [
  { href: '/katalog/', label: 'Katalog' },
  { href: '/bundles/', label: 'Bundle' },
  { href: '/docs/', label: 'Dokumentasi' },
  { href: '/metodologi/', label: 'Metodologi' },
  { href: '/tentang/', label: 'Tentang' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#315f52" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AHS-ID" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={resolvedCanonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Langsung ke konten utama</a>
    <header class="sticky top-0 z-40 border-b border-border/80 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/80">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-5 lg:px-8">
        <a class="group pressable inline-flex items-center gap-3" href="/" aria-label="AHS-ID, beranda">
          <span class="grid h-9 w-9 place-items-center rounded-full border border-foreground/70 font-serif text-lg leading-none transition-transform duration-150 group-hover-fine-rotate-6">A</span>
          <span class="font-serif text-xl tracking-tight">AHS-ID</span>
        </a>

        <nav class="hidden items-center gap-7 md:flex" aria-label="Navigasi utama">
          {navItems.map((item) => (
            <a
              class:list={[
                'pressable inline-flex min-h-11 items-center text-sm transition-colors hover-fine-text-primary',
                currentPath.startsWith(item.href) ? 'font-semibold text-primary' : 'text-muted-foreground',
              ]}
              aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
              href={item.href}
            >
              {item.label}
            </a>
          ))}
          <a class="pressable inline-flex min-h-11 items-center text-sm text-muted-foreground transition-colors hover-fine-text-primary" href="https://github.com/rachmad-jenss/ahs-id" rel="noreferrer">GitHub</a>
        </nav>

        <details class="group relative md:hidden">
          <summary class="pressable flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border border-border px-4 text-sm font-semibold marker:hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
            Menu <ChevronDown aria-hidden="true" className="h-4 w-4 transition-transform duration-150 group-open:rotate-180" />
          </summary>
          <nav class="mobile-menu-panel absolute right-0 top-14 w-56 rounded-2xl border border-border bg-card p-2 shadow-xl" aria-label="Navigasi mobile">
            {navItems.map((item) => (
              <a
                class:list={[
                  'pressable flex min-h-11 items-center rounded-xl px-3 py-2 text-sm text-foreground hover-fine-bg-muted',
                  currentPath.startsWith(item.href) ? 'bg-muted font-semibold' : '',
                ]}
                aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
                href={item.href}
              >{item.label}</a>
            ))}
            <a class="pressable flex min-h-11 items-center rounded-xl px-3 py-2 text-sm text-foreground hover-fine-bg-muted" href="https://github.com/rachmad-jenss/ahs-id" rel="noreferrer">GitHub</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="border-t border-border/80">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 lg:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
        <div>
          <div class="font-serif text-2xl">AHS-ID</div>
          <p class="mt-3 max-w-sm text-sm leading-6 text-muted-foreground">Engine perhitungan dan bundle data AHSP Indonesia yang terbuka, terstruktur, dan dapat diaudit.</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Jelajahi</p>
          <div class="mt-4 grid gap-3 text-sm">
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/katalog/">Katalog AHSP</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/bundles/">Bundle data</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/metodologi/">Sumber dan metodologi</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/tentang/">Tentang AHS-ID</a>
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Dibuat untuk developer</p>
          <div class="mt-4 grid gap-3 text-sm">
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="/docs/">Quick start npm</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="https://github.com/rachmad-jenss/ahs-id" rel="noreferrer">Source di GitHub</a>
            <a class="pressable inline-flex min-h-11 items-center hover-fine-text-primary" href="https://www.npmjs.com/org/ahs-id" rel="noreferrer">Package di npm</a>
          </div>
        </div>
      </div>
      <div class="mx-auto flex max-w-7xl flex-col gap-2 border-t border-border/60 px-5 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between lg:px-8">
        <span>MIT License · © 2026 AHS-ID</span>
        <span>Data regulasi perlu diverifikasi terhadap sumber resmi sebelum dipakai dalam dokumen pengadaan.</span>
      </div>
    </footer>
  </body>
</html>
