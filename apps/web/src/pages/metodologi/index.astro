---
import { ArrowRight, CheckCircle2, FileCheck2, GitBranch } from 'lucide-react';
import { Badge } from '../../components/ui/badge';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { bundleIndex as ahspSourceBundles } from '@ahs-id/ahsp-dcktrp-by-source';
import { manifest as hspManifest } from '@ahs-id/hsp-jakarta-dcktrp';
import { buildHsdLibraryPackages, JAKARTA_DATA_LAYERS, VERIFICATION_TIER_LABELS } from '../../lib/library-packages';

const hsdPackages = buildHsdLibraryPackages();
const jakartaLegalRefs = hspManifest.dasar_hukum_summary ?? [];
---

<SiteLayout title="Metodologi dan jejak sumber — AHS-ID" description="Cara AHS-ID menyusun, menormalisasi, dan menjelaskan data AHSP publik serta status verifikasi HSD.">
  <section class="border-b border-border/80 bg-card/45"><div class="mx-auto max-w-7xl px-5 pb-14 pt-16 lg:px-8 lg:pb-20 lg:pt-24"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Metodologi</p><h1 class="mt-4 max-w-4xl font-serif text-5xl leading-[1.02] tracking-[-0.04em] sm:text-7xl">Data yang punya jejak.</h1><p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">AHS-ID memisahkan fakta sumber, normalisasi untuk konsumsi engine, dan status verifikasi agar pengguna bisa menilai data sesuai kebutuhan proyek.</p></div></section>
  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
    <div class="grid gap-5 md:grid-cols-3">
      <article class="rounded-3xl border border-border bg-card/50 p-7"><span class="grid h-11 w-11 place-items-center rounded-2xl bg-primary text-primary-foreground"><GitBranch aria-hidden="true" className="h-5 w-5" /></span><p class="mt-7 font-mono text-xs uppercase tracking-[0.18em] text-primary">01 · Sumber</p><h2 class="mt-3 font-serif text-2xl">Bundel sebagai sumber</h2><p class="mt-3 text-sm leading-6 text-muted-foreground">Item berasal dari paket AHSP yang memiliki metadata regulasi, versi, bidang, dan jejak sumber.</p></article>
      <article class="rounded-3xl border border-border bg-card/50 p-7"><span class="grid h-11 w-11 place-items-center rounded-2xl bg-primary text-primary-foreground"><FileCheck2 aria-hidden="true" className="h-5 w-5" /></span><p class="mt-7 font-mono text-xs uppercase tracking-[0.18em] text-primary">02 · Normalisasi</p><h2 class="mt-3 font-serif text-2xl">Satu bentuk untuk dicari</h2><p class="mt-3 text-sm leading-6 text-muted-foreground">Bundel HSD dinamis dan koefisien tetap dipetakan ke model tampilan yang konsisten tanpa mengubah data paket.</p></article>
      <article class="rounded-3xl border border-border bg-card/50 p-7"><span class="grid h-11 w-11 place-items-center rounded-2xl bg-primary text-primary-foreground"><CheckCircle2 aria-hidden="true" className="h-5 w-5" /></span><p class="mt-7 font-mono text-xs uppercase tracking-[0.18em] text-primary">03 · Verifikasi</p><h2 class="mt-3 font-serif text-2xl">Status terlihat</h2><p class="mt-3 text-sm leading-6 text-muted-foreground">Tier verifikasi, sumber regulasi, halaman, dan tanggal verifikasi ditampilkan ketika tersedia.</p></article>
    </div>

    <div class="mt-16 max-w-3xl" id="jakarta-tiga-lapisan">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">DKI Jakarta</p>
      <h2 class="mt-4 font-serif text-4xl tracking-[-0.03em]">Tiga lapisan data (bukan satu bundel AHSP)</h2>
      <div class="mt-7 grid gap-5 text-sm leading-6 text-muted-foreground">
        <p><span class="font-medium text-foreground">{JAKARTA_DATA_LAYERS.ahspRegulasi.title}.</span> {JAKARTA_DATA_LAYERS.ahspRegulasi.description} Paket: <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">{JAKARTA_DATA_LAYERS.ahspRegulasi.npmName}</code> ({ahspSourceBundles.length} sub-bundel).</p>
        <p><span class="font-medium text-foreground">{JAKARTA_DATA_LAYERS.hsdDaerah.title}.</span> {JAKARTA_DATA_LAYERS.hsdDaerah.description} Paket: <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">{JAKARTA_DATA_LAYERS.hsdDaerah.npmName}</code>.</p>
        <p><span class="font-medium text-foreground">{JAKARTA_DATA_LAYERS.hspPortal.title}.</span> {JAKARTA_DATA_LAYERS.hspPortal.description} Paket: <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">{JAKARTA_DATA_LAYERS.hspPortal.npmName}</code> ({hspManifest.item_count.toLocaleString('id-ID')} item).</p>
      </div>
      {
        jakartaLegalRefs.length > 0 ? (
          <div class="mt-8 overflow-hidden rounded-2xl border border-border">
            <table class="w-full text-left text-sm">
              <caption class="sr-only">Rujukan hukum per item HSP portal Jakarta</caption>
              <thead class="border-b border-border bg-muted/50 text-xs uppercase tracking-[0.12em] text-muted-foreground">
                <tr>
                  <th class="px-4 py-3 font-medium" scope="col">Dasar hukum (metadata portal)</th>
                  <th class="px-4 py-3 font-medium" scope="col">Item</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border/70">
                {jakartaLegalRefs.slice(0, 8).map((row) => (
                  <tr>
                    <td class="px-4 py-3 leading-6 text-muted-foreground">{row.label}</td>
                    <td class="px-4 py-3 font-mono text-xs">{row.item_count.toLocaleString('id-ID')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : null
      }
    </div>

    <div class="mt-16 max-w-3xl" id="se47-nasional">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Nasional · SE 47/2026</p>
      <h2 class="mt-4 font-serif text-4xl tracking-[-0.03em]">Ekstraksi Lampiran dan penautan kode AHSP</h2>
      <div class="mt-7 grid gap-5 text-sm leading-6 text-muted-foreground">
        <p>
          Lampiran SE Direktur Jenderal Bina Konstruksi <span class="font-medium text-foreground">SE 47/SE/Dk/2026</span> (SDA, Bina Marga, Cipta Karya) diproses di repo dengan toolchain <span class="font-medium text-foreground">Docling</span> (Python, tidak dipublikasikan ke npm). Alur: PDF → tabel terstruktur → analisis HSP → penautan <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">kode_ahsp</code> ke baris breakdown → spot-check sampel ke PDF.
        </p>
        <p>
          Tiga jalur bidang memakai strategi berbeda: <span class="font-medium text-foreground">SDA</span> (header item + L01), <span class="font-medium text-foreground">Bina Marga</span> (blok formular + tabel HSP kanonik), dan <span class="font-medium text-foreground">Cipta Karya</span> (kode inline di Lampiran V). Gate otomatis <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">pnpm national:se47-validate-all</code> menggabungkan manifest bersih, full-check PDF, dan ambang penautan (≥90% SDA/CK, ≥95% blok formular BM dengan HSP ter-ekstrak).
        </p>
        <p>
          Per integrasi <span class="font-medium text-foreground">DAS-56</span> (Oktober 2026), cakupan penautan referensi: SDA <span class="font-medium text-foreground">~94%</span> baris HSP, Cipta Karya <span class="font-medium text-foreground">~99,6%</span>, formular Bina Marga <span class="font-medium text-foreground">~99,9%</span> pada blok yang punya HSP ter-ekstrak. Angka ini mengukur konsistensi metadata ekstraksi, bukan sertifikasi kesesuaian koefisien dengan PDF resmi.
        </p>
      </div>
      <a
        class="pressable mt-8 inline-flex items-center gap-2 text-sm font-semibold text-primary hover-fine-underline"
        href="https://github.com/rachmad-jenss/ahs-id/tree/main/tools/docling"
        rel="noreferrer"
      >
        Baca panduan Docling di GitHub <ArrowRight aria-hidden="true" className="h-4 w-4" />
      </a>
    </div>

    <div class="mt-16 max-w-3xl" id="kebijakan-verifikasi">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Kebijakan verifikasi</p>
      <h2 class="mt-4 font-serif text-4xl tracking-[-0.03em]">Apa yang dijamin repo, dan apa yang menjadi tanggung jawab proyek.</h2>
      <div class="mt-7 grid gap-5 text-sm leading-6 text-muted-foreground">
        <p>
          <span class="font-medium text-foreground">Golden test (ε 0,01 Rp)</span> mengunci bahwa kombinasi bundel + HSD + input variabel menghasilkan angka yang sama dengan fixture yang direview. Itu jaminan <span class="font-medium text-foreground">konsistensi engine</span>, bukan sertifikasi bahwa setiap rupiah cocok dengan SK atau PDF regulasi terbaru.
        </p>
        <p>
          <span class="font-medium text-foreground">Item AHSP di katalog</span> banyak berstatus tier <Badge variant="muted">{VERIFICATION_TIER_LABELS['auto-extracted']}</Badge> — artinya struktur dan koefisien diekstrak ke JSON dan divalidasi skema, tetapi belum seluruhnya diaudit manual ke halaman sumber. Tier lebih tinggi (<Badge variant="muted">{VERIFICATION_TIER_LABELS['spot-checked']}</Badge>, {VERIFICATION_TIER_LABELS.verified}, {VERIFICATION_TIER_LABELS.executed}) ditampilkan per item bila ada di provenance.
        </p>
        <p>
          <span class="font-medium text-foreground">Paket HSD regional</span> membawa <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">verification_tier</code> dan <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">verification_note</code> di metadata wilayah. Tiga paket Q1 2025 adalah dataset referensi untuk pengujian band harga (rendah / menengah / tinggi), bukan salinan SK gubernur. <span class="font-medium text-foreground">@ahs-id/hsd-bm-2022</span> mengacu lampiran Permen PUPR 1/2022 dan berstatus {VERIFICATION_TIER_LABELS['spot-checked']}.
        </p>
      </div>

      <div class="mt-10 overflow-hidden rounded-2xl border border-border">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Status verifikasi paket HSD regional</caption>
          <thead class="border-b border-border bg-muted/50 text-xs uppercase tracking-[0.12em] text-muted-foreground">
            <tr>
              <th class="px-4 py-3 font-medium" scope="col">Paket</th>
              <th class="px-4 py-3 font-medium" scope="col">Status</th>
              <th class="px-4 py-3 font-medium" scope="col">Dasar hukum (metadata)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/70">
            {
              hsdPackages.map((pkg) => (
                <tr>
                  <td class="px-4 py-3 font-mono text-xs text-primary sm:text-sm">{pkg.npmName}</td>
                  <td class="px-4 py-3"><Badge variant="muted">{pkg.verificationLabel}</Badge></td>
                  <td class="px-4 py-3 leading-6 text-muted-foreground">{pkg.legalBasis}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-6 text-sm leading-6 text-muted-foreground">
        Engine dapat memperingatkan HSD yang sudah lama (<code class="rounded bg-muted px-1.5 py-0.5 font-mono text-xs text-foreground">hsd_staleness_warning_days</code>). Itu pengingat operasional, bukan pengganti cek dokumen resmi.
      </p>
      <a class="pressable mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary hover-fine-underline" href="/bundles/">Lihat semua paket npm <ArrowRight aria-hidden="true" className="h-4 w-4" /></a>
    </div>

    <div class="mt-16 max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Batas penggunaan</p>
      <h2 class="mt-4 font-serif text-4xl tracking-[-0.03em]">Katalog membantu membaca data. Keputusan tetap perlu validasi proyek.</h2>
      <div class="mt-7 grid gap-4 text-sm leading-6 text-muted-foreground">
        <p>Website ini tidak menggantikan dokumen regulasi resmi, pertimbangan engineer, harga lokal, atau pemeriksaan kuantitas. Harga referensi dan HSD hanya bermakna dalam konteks bundel dan periode berlakunya.</p>
        <p>Gunakan paket engine untuk kalkulasi yang membutuhkan HSD regional, tahap volume, produktivitas, overhead, dan profit. Katalog publik ini berfokus pada struktur AHSP dan jejak datanya.</p>
      </div>
      <a class="pressable mt-8 inline-flex items-center gap-2 text-sm font-semibold text-primary hover-fine-underline" href="/docs/">Lihat dokumentasi developer <ArrowRight aria-hidden="true" className="h-4 w-4" /></a>
    </div>
  </section>
</SiteLayout>
