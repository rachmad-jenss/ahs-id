---
import { CatalogBrowser } from '../../components/CatalogBrowser';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { buildCatalog } from '../../lib/catalog';
import { parseCatalogSearchParams } from '../../lib/catalog-url';
import { toSearchIndex } from '../../lib/search';

const catalog = buildCatalog();
const entries = toSearchIndex(catalog.items);
const initialParams = parseCatalogSearchParams(Astro.url.searchParams);
---

<SiteLayout
  title="Katalog AHSP — AHS-ID"
  description="Cari dan telusuri item AHSP Indonesia dari bundel PUPR, Bina Marga, dan Cipta Karya."
>
  <section class="border-b border-border/80 bg-card/45">
    <div class="mx-auto max-w-7xl px-5 pb-12 pt-14 lg:px-8 lg:pb-16 lg:pt-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Katalog publik</p>
        <h1 class="mt-4 font-serif text-5xl tracking-[-0.04em] sm:text-7xl">Cari pekerjaan dengan cepat.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">{catalog.items.length.toLocaleString('id-ID')} item publik dari {catalog.bundles.length} bundel. Gunakan kode, nama pekerjaan, bidang, bundel, atau satuan.</p>
      </div>
    </div>
  </section>
  <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-16" data-catalog-shell>
    <CatalogBrowser
      bundles={catalog.bundles}
      entries={entries}
      initialParams={initialParams}
      client:load
    />
  </div>
</SiteLayout>

<script is:inline>
  const catalogSearch = new URLSearchParams(window.location.search);
  const hasCatalogParams = ['q', 'bundle', 'bidang', 'unit', 'page'].some((key) => catalogSearch.has(key));
  if (hasCatalogParams) {
    const catalogShell = document.querySelector('[data-catalog-shell]');
    catalogShell?.setAttribute('data-catalog-url-pending', '');
    window.setTimeout(() => catalogShell?.removeAttribute('data-catalog-url-pending'), 3000);
  }
</script>
