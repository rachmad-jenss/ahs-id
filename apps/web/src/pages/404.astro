---
import { ArrowLeft, SearchX } from 'lucide-react';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Halaman tidak ditemukan — AHS-ID" description="Halaman yang Anda cari tidak tersedia.">
  <section class="mx-auto grid min-h-[60vh] max-w-3xl place-items-center px-5 py-20 text-center lg:px-8"><div><SearchX aria-hidden="true" className="mx-auto h-10 w-10 text-primary" /><p class="mt-7 font-mono text-sm text-muted-foreground">404 · NOT FOUND</p><h1 class="mt-4 font-serif text-5xl tracking-[-0.04em] sm:text-6xl">Halaman ini belum ada.</h1><p class="mx-auto mt-5 max-w-md leading-7 text-muted-foreground">Coba kembali ke katalog atau mulai dari pencarian item AHSP.</p><div class="mt-8 flex justify-center gap-3"><a class="pressable inline-flex min-h-11 items-center rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground hover-fine-bg-primary-90" href="/katalog/">Buka katalog</a><a class="pressable inline-flex min-h-11 items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-sm font-semibold hover-fine-bg-muted" href="/"><ArrowLeft aria-hidden="true" className="h-4 w-4" /> Beranda</a></div></div></section>
</SiteLayout>
