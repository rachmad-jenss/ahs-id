---
import { CalculatorApp } from '../../components/CalculatorApp';
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Kalkulator HSP — AHS-ID"
  description="Hitung harga satuan pekerjaan dari bundel AHSP dan HSD regional — registry yang sama dengan CLI."
>
  <section class="border-b border-border/80 bg-card/45">
    <div class="mx-auto max-w-7xl px-5 pb-12 pt-14 lg:px-8 lg:pb-16 lg:pt-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Kalkulator</p>
        <h1 class="mt-4 font-serif text-5xl tracking-[-0.04em] sm:text-7xl">Hitung HSP di browser.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">
          Memakai `@ahs-id/engine-registry` yang sama dengan CLI. Prefill dari katalog dengan query `bundle` dan `item`.
        </p>
      </div>
    </div>
  </section>
  <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-16">
    <CalculatorApp client:load />
  </div>
</SiteLayout>
