---
import { ArrowLeft, ExternalLink } from 'lucide-react';
import { Badge } from '../../../../components/ui/badge';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { catalogItemSlug } from '../../../../lib/catalog';
import { loadDcktrpAhspItems, type DcktrpAhspItem } from '../../../../lib/dcktrp-catalog';

export async function getStaticPaths() {
  const items = await loadDcktrpAhspItems();
  return items.map((item) => ({
    params: { sourceId: item.sourceId, code: catalogItemSlug(item.code) },
    props: { item },
  }));
}

const { item } = Astro.props as { item: DcktrpAhspItem };
const pageTitle = `${item.code} — ${item.name} · AHSP portal`;
const pageDescription = `Koefisien AHSP portal DCKTRP dari ${item.sourceTitle}.`;
const formatCoef = (value: unknown): string =>
  typeof value === 'number' ? value.toLocaleString('id-ID', { maximumFractionDigits: 8 }) : '—';
---

<SiteLayout title={pageTitle} description={pageDescription}>
  <article class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-20">
    <a class="pressable inline-flex items-center gap-2 text-sm text-muted-foreground hover-fine-text-primary" href="/katalog/?kind=ahsp-coef">
      <ArrowLeft aria-hidden="true" className="h-4 w-4" /> Kembali ke katalog
    </a>
    <div class="mt-10 flex flex-wrap items-center gap-2">
      <Badge>AHSP portal DCKTRP</Badge>
      <Badge variant="outline">{item.sourceTitle}</Badge>
      <Badge variant="muted">{item.bidang}</Badge>
    </div>
    <p class="mt-7 font-mono text-lg font-semibold text-primary">{item.code}</p>
    <h1 class="mt-3 max-w-4xl font-serif text-5xl leading-[1.02] tracking-[-0.04em] sm:text-6xl">{item.name}</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">
      Entri portal per sumber hukum (bukan bundel nasional Docling). Satuan <span class="font-semibold text-foreground">{item.unit || '—'}</span>, divisi {item.divisi}.
    </p>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1fr_18rem]">
      <section aria-labelledby="dcktrp-components-heading">
        <h2 class="font-serif text-3xl" id="dcktrp-components-heading">Koefisien komponen</h2>
        <div class="mt-5 overflow-hidden rounded-2xl border border-border">
          {[
            { label: 'Tenaga kerja', rows: item.tenagaKerja },
            { label: 'Bahan', rows: item.bahan },
            { label: 'Peralatan', rows: item.peralatan },
          ].filter((group) => group.rows.length > 0).map((group) => (
            <div class="border-b border-border last:border-b-0">
              <h3 class="bg-muted/55 px-5 py-3 text-xs font-semibold uppercase tracking-[0.15em] text-muted-foreground">{group.label}</h3>
              <table class="w-full text-left text-sm">
                <thead class="border-b border-border/70 text-xs text-muted-foreground">
                  <tr>
                    <th class="px-5 py-3 font-medium" scope="col">Komponen</th>
                    <th class="px-5 py-3 text-right font-medium" scope="col">Koefisien</th>
                    <th class="px-5 py-3 text-right font-medium" scope="col">Satuan</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border/60">
                  {group.rows.map((row) => (
                    <tr>
                      <td class="px-5 py-3">
                        <div class="font-medium">{String(row.nama ?? row.ref ?? '—')}</div>
                        {row.ref != null && <div class="mt-1 font-mono text-xs text-muted-foreground">{String(row.ref)}</div>}
                      </td>
                      <td class="px-5 py-3 text-right font-mono">{formatCoef(row.koefisien)}</td>
                      <td class="px-5 py-3 text-right text-muted-foreground">{String(row.satuan ?? '—')}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      </section>
      <aside class="h-fit rounded-3xl border border-border bg-card/55 p-6 text-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.15em] text-muted-foreground">Ringkasan</p>
        <dl class="mt-5 grid gap-4">
          <div><dt class="text-muted-foreground">Sumber</dt><dd class="mt-1 font-medium">{item.sourceTitle}</dd></div>
          <div><dt class="text-muted-foreground">Sub-divisi</dt><dd class="mt-1 font-mono">{item.subDivision || '—'}</dd></div>
          <div><dt class="text-muted-foreground">Harga ref</dt><dd class="mt-1 font-mono">{item.referencePrice != null ? item.referencePrice.toLocaleString('id-ID') : '—'}</dd></div>
        </dl>
        <p class="mt-6 text-xs leading-5 text-muted-foreground">Entri portal DCKTRP — bukan bundel kalkulasi engine. Untuk hitung HSP, pilih item di katalog AHSP nasional.</p>
        <a class="pressable mt-4 inline-flex min-h-11 items-center justify-center rounded-full border border-border px-4 text-sm font-semibold" href={`/katalog/?q=${encodeURIComponent(item.code)}&kind=ahsp-coef`}>
          Cari di katalog
        </a>
        {item.dokumenUrl && (
          <a class="pressable mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary" href={item.dokumenUrl} rel="noreferrer" target="_blank">
            Dokumen sumber <ExternalLink aria-hidden="true" className="h-4 w-4" />
          </a>
        )}
      </aside>
    </div>
  </article>
</SiteLayout>
