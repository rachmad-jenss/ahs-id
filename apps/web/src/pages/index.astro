---
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { ArrowRight, BookOpen, Check, Code2, GitBranch, Search } from 'lucide-react';
import { SearchLauncher } from '../components/SearchLauncher';
import { Badge } from '../components/ui/badge';
import SiteLayout from '../layouts/SiteLayout.astro';
import { buildCatalog, catalogItemPath, type CatalogItem } from '../lib/catalog';
import type { SearchManifest } from '../lib/search-index';

const catalog = buildCatalog();
const catalogBidangCount = new Set(catalog.items.map((item) => item.bidang)).size;
let searchManifest: SearchManifest | null = null;
try {
  searchManifest = JSON.parse(
    await readFile(join(process.cwd(), 'public/search/manifest.json'), 'utf8'),
  ) as SearchManifest;
} catch {
  searchManifest = null;
}
const indexedTotal = searchManifest?.total ?? catalog.items.length;
const featuredCodes = [
  ['pupr-2023', '3.1.1'],
  ['bina-marga-2022', '2.1.(1)'],
  ['cipta-karya-2024', '1.2.1.1.1'],
] as const;
const featured = featuredCodes
  .map(([bundleId, code]) => catalog.items.find((item) => item.bundleId === bundleId && item.code === code))
  .filter((item): item is CatalogItem => Boolean(item));
---

<SiteLayout
  title="AHS-ID — Data AHSP Indonesia yang terbuka"
  description="Jelajahi data AHSP Indonesia yang terstruktur, terbuka, dan dapat ditelusuri sumbernya."
>
  <section class="relative overflow-hidden border-b border-border/80">
    <div class="home-hero-backdrop absolute inset-0 -z-10"></div>
    <div class="mx-auto flex max-w-7xl flex-col items-center px-5 pb-20 pt-16 text-center lg:px-8 lg:pb-28 lg:pt-24">
      <div class="flex w-full max-w-4xl flex-col items-center">
        <div class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">
          Project open-source untuk Indonesia
        </div>
        <h1 class="mt-7 max-w-4xl font-serif text-5xl leading-[.98] tracking-[-0.045em] sm:text-6xl lg:text-7xl">
          Temukan data AHSP dengan jejak sumber yang jelas.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl">
          Cari item pekerjaan, pahami konteks regulasinya, lalu gunakan datanya kembali untuk alur kerja Anda.
        </p>
        <div class="mt-9 w-full max-w-3xl">
          <SearchLauncher examples={[{ label: 'Galian tanah', query: 'galian tanah' }, { label: '3.1.1', query: '3.1.1' }, { label: 'Bina Marga', query: 'Bina Marga' }]} client:load />
        </div>
        <div class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm text-muted-foreground">
          <a class="pressable inline-flex items-center gap-2 font-semibold text-foreground hover-fine-text-primary" href="/katalog/">
            Buka katalog <ArrowRight aria-hidden="true" className="h-4 w-4" />
          </a>
          <a class="pressable inline-flex items-center gap-2 hover-fine-text-primary" href="/docs/">
            Mulai dari npm <Code2 aria-hidden="true" className="h-4 w-4" />
          </a>
        </div>
      </div>

      <div class="relative mt-14 w-full max-w-4xl lg:mt-16">
        <div class="absolute -right-4 -top-12 hidden h-40 w-40 rounded-full border border-primary/20 lg:block"></div>
        <article class="catalog-hero-panel relative overflow-hidden rounded-3xl border border-border/80 bg-card text-left text-card-foreground">
          <div class="relative flex flex-col gap-6 p-6 sm:p-8">
            <header class="max-w-2xl">
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Ringkasan katalog</p>
              <h2 class="mt-3 font-serif text-3xl leading-tight tracking-[-0.03em] sm:text-4xl">Data yang siap ditelusuri.</h2>
              <p class="mt-2 text-sm leading-6 text-muted-foreground">
                Katalog terbuka dengan metadata regulasi dan jejak sumber pada setiap item.
              </p>
            </header>

            <div class="grid border-y border-border/80 sm:grid-cols-3 sm:divide-x sm:divide-border/80">
              <a class="pressable block py-5 transition-colors hover-fine-bg-muted-50 sm:px-5 sm:first:pl-0" href="/katalog/">
                <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">Entri terindeks</p>
                <p class="mt-2 font-mono text-3xl font-semibold tabular-nums tracking-tight text-primary sm:text-4xl">{indexedTotal.toLocaleString('id-ID')}</p>
              </a>
              <a class="pressable block border-t border-border/80 py-5 transition-colors hover-fine-bg-muted-50 sm:border-t-0 sm:px-5" href="/bundles/">
                <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">Bundel regulasi</p>
                <p class="mt-2 font-mono text-3xl font-semibold tabular-nums tracking-tight sm:text-4xl">{catalog.bundles.length}</p>
              </a>
              <a class="pressable block border-t border-border/80 py-5 transition-colors hover-fine-bg-muted-50 sm:border-t-0 sm:px-5 sm:last:pr-0" href="/katalog/">
                <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted-foreground">Bidang pekerjaan</p>
                <p class="mt-2 font-mono text-3xl font-semibold tabular-nums tracking-tight sm:text-4xl">{catalogBidangCount}</p>
              </a>
            </div>

            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-5">
              <a class="pressable group block flex-1 text-left sm:max-w-md" href="/metodologi/">
                <span class="block text-sm font-semibold text-foreground">Sumber bisa dilacak</span>
                <span class="mt-1 block text-sm leading-5 text-muted-foreground">
                  Regulasi, halaman rujukan, bundel asal, dan tingkat verifikasi pada setiap item.
                </span>
                <span class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-primary hover-fine-underline">
                  Baca metodologi
                  <ArrowRight aria-hidden="true" className="h-3.5 w-3.5" />
                </span>
              </a>

              <a
                class="inline-flex min-h-11 w-full shrink-0 items-center justify-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-sm transition-[transform,background-color] duration-150 ease-out hover-fine-bg-primary-90 active:scale-[0.98] sm:w-auto"
                href="/katalog/"
              >
                Buka katalog
                <ArrowRight aria-hidden="true" className="h-4 w-4" />
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Kenapa AHS-ID</p>
        <h2 class="mt-4 max-w-md font-serif text-4xl leading-tight tracking-[-0.03em] sm:text-5xl">Dibuat untuk ditelusuri, bukan sekadar disalin.</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        <article class="border-t-2 border-primary pt-5">
          <Search aria-hidden="true" className="h-5 w-5 text-primary" />
          <h3 class="mt-5 font-semibold">Cari dengan konteks</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">Kode, nama pekerjaan, bidang, bundel, dan satuan tersedia dalam satu katalog.</p>
        </article>
        <article class="border-t-2 border-primary pt-5">
          <GitBranch aria-hidden="true" className="h-5 w-5 text-primary" />
          <h3 class="mt-5 font-semibold">Sumber tetap terlihat</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">Metadata regulasi dan jejak sumber ikut dibawa oleh paket data.</p>
        </article>
        <article class="border-t-2 border-primary pt-5">
          <Code2 aria-hidden="true" className="h-5 w-5 text-primary" />
          <h3 class="mt-5 font-semibold">Siap dipakai ulang</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">Engine TypeScript, bundel JSON, dan dokumentasi terbuka untuk alur kerja berikutnya.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-border/80 bg-card/45">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Mulai dari item</p>
          <h2 class="mt-3 font-serif text-4xl tracking-[-0.03em] sm:text-5xl">Beberapa jalur kerja populer.</h2>
        </div>
        <a class="pressable inline-flex items-center gap-2 text-sm font-semibold hover-fine-text-primary" href="/katalog/">Lihat semua item <ArrowRight aria-hidden="true" className="h-4 w-4" /></a>
      </div>
      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {featured.map((item) => (
          <a class="featured-card-enter group pressable hover-fine-card rounded-3xl border border-border bg-background p-6 transition-[transform,border-color,box-shadow] duration-200 ease-out" href={catalogItemPath(item.bundleId, item.code)}>
            <div class="flex items-start justify-between gap-4">
              <span class="font-mono text-sm font-semibold text-primary">{item.code}</span>
              <Badge variant="muted">{item.unit}</Badge>
            </div>
            <h3 class="featured-card-title mt-8 h-[5.625rem] font-serif text-2xl leading-tight">{item.name}</h3>
            <div class="mt-8 flex items-center justify-between border-t border-border/80 pt-4 text-xs text-muted-foreground">
              <span>{item.bundleName}</span>
              <ArrowRight aria-hidden="true" className="h-4 w-4 transition-[transform,color] duration-200 ease-out group-hover-fine-arrow" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid min-w-0 gap-12 lg:grid-cols-[1fr_.9fr] lg:items-center">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Untuk alur kerja engineer</p>
        <h2 class="mt-4 max-w-xl font-serif text-4xl leading-tight tracking-[-0.03em] sm:text-5xl">Dari bundel regulasi ke kalkulasi yang bisa diaudit.</h2>
        <p class="mt-6 max-w-xl text-base leading-7 text-muted-foreground">AHS-ID memisahkan engine, data AHSP, dan HSD regional sebagai paket yang dapat dirangkai. Baca struktur data, jalankan kalkulasi, lalu ekspor hasilnya ke alur kerja Anda.</p>
        <div class="mt-8 grid gap-3 text-sm">
          <div class="flex items-center gap-3"><Check aria-hidden="true" className="h-5 w-5 text-primary" /> TypeScript strict dan branded types</div>
          <div class="flex items-center gap-3"><Check aria-hidden="true" className="h-5 w-5 text-primary" /> Validasi schema dan golden tests</div>
          <div class="flex items-center gap-3"><Check aria-hidden="true" className="h-5 w-5 text-primary" /> Data bundel terpisah dari engine</div>
        </div>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="pressable inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover-fine-bg-primary-90" href="/docs/">Buka quick start <ArrowRight aria-hidden="true" className="h-4 w-4" /></a>
          <a class="pressable inline-flex min-h-11 items-center justify-center gap-2 whitespace-nowrap rounded-full border border-border bg-background px-4 py-2 text-sm font-semibold transition-colors hover-fine-bg-muted" href="https://github.com/rachmad-jenss/ahs-id" rel="noreferrer">Lihat kode sumber <GitBranch aria-hidden="true" className="h-4 w-4" /></a>
        </div>
      </div>
       <div class="code-surface code-foreground min-w-0 rounded-[2rem] p-5 shadow-2xl shadow-primary/10 sm:p-7">
        <div class="code-muted flex items-center gap-2 text-xs font-mono"><span class="h-2 w-2 rounded-full bg-primary"></span> npm quick start</div>
        <p class="code-muted mt-3 text-xs sm:hidden">Geser kode ke samping untuk melihat baris lengkap.</p>
        <pre class="code-foreground mt-6 min-w-0 max-w-full overflow-x-auto text-sm leading-7" tabindex="0" role="region" aria-label="Contoh kode npm quick start"><code><span class="code-keyword">import</span> {'{ createCalculator }'} <span class="code-keyword">from</span> <span class="code-string">'@ahs-id/core'</span><br /><span class="code-keyword">import</span> {'{ bundle }'} <span class="code-keyword">from</span> <span class="code-string">'@ahs-id/pupr-2023'</span><br /><span class="code-keyword">import</span> {'{ hsd }'} <span class="code-keyword">from</span> <span class="code-string">'@ahs-id/hsd-kaltim-2025'</span><br /><br /><span class="code-keyword">const</span> calculator = createCalculator(bundle, hsd)<br /><span class="code-keyword">const</span> result = calculator.hitungHSP(<span class="code-string">'3.1.1'</span>, {'{'} jarak_buang_km: <span class="code-number">5</span>, kondisi_jalan: <span class="code-string">'sedang'</span>, jenis_material: <span class="code-string">'tanah_biasa'</span> {'}'})</code></pre>
        <div class="code-muted mt-6 flex items-center gap-2 border-t code-border pt-5 text-xs"><BookOpen aria-hidden="true" className="code-muted h-4 w-4" /> Dokumentasi berkembang bersama paket</div>
      </div>
    </div>
  </section>

  <section class="bg-primary text-primary-foreground">
    <div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-16 sm:flex-row sm:items-center sm:justify-between lg:px-8 lg:py-20">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary-foreground">Langkah berikutnya</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl leading-tight tracking-[-0.03em] sm:text-5xl">Temukan item yang sedang Anda kerjakan.</h2>
      </div>
      <a class="pressable inline-flex min-h-11 w-fit items-center justify-center gap-2 whitespace-nowrap rounded-full bg-primary-foreground px-5 py-3 text-sm font-semibold text-primary shadow-sm transition-colors hover-fine-bg-primary-foreground-90" href="/katalog/">Buka katalog <ArrowRight aria-hidden="true" className="h-4 w-4" /></a>
    </div>
  </section>
</SiteLayout>
