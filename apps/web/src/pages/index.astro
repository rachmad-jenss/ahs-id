---
import { ArrowRight, BookOpen, Check, Code2, Database, GitBranch, Search, ShieldCheck } from 'lucide-react';
import { SearchLauncher } from '../components/SearchLauncher';
import { Badge } from '../components/ui/badge';
import SiteLayout from '../layouts/SiteLayout.astro';
import { buildCatalog, catalogItemPath, type CatalogItem } from '../lib/catalog';

const catalog = buildCatalog();
const featuredCodes = [
  ['pupr-2023', '3.1.1'],
  ['bina-marga-2022', '2.1.(1)'],
  ['cipta-karya-2024', '1.2.1.1.1'],
] as const;
const featured = featuredCodes
  .map(([bundleId, code]) => catalog.items.find((item) => item.bundleId === bundleId && item.code === code))
  .filter((item): item is CatalogItem => Boolean(item));
---

<SiteLayout
  title="AHS-ID — Data AHSP Indonesia yang terbuka"
  description="Jelajahi data AHSP Indonesia yang terstruktur, terbuka, dan dapat ditelusuri sumbernya."
>
  <section class="relative overflow-hidden border-b border-border/80">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_80%_10%,oklch(0.87_0.08_166/.5),transparent_34%),linear-gradient(115deg,oklch(0.975_0.012_84),oklch(0.94_0.035_82))]"></div>
    <div class="mx-auto grid max-w-7xl gap-14 px-5 pb-20 pt-16 lg:grid-cols-[1.1fr_.9fr] lg:items-end lg:px-8 lg:pb-28 lg:pt-24">
      <div>
        <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-primary">
          <span class="h-px w-10 bg-primary"></span>
          Open source · Indonesia
        </div>
        <h1 class="mt-7 max-w-4xl font-serif text-5xl leading-[.98] tracking-[-0.045em] sm:text-6xl lg:text-8xl">
          Angka yang rapi untuk pekerjaan yang nyata.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-muted-foreground sm:text-xl">
          AHS-ID menyusun Analisa Harga Satuan Pekerjaan Indonesia menjadi data yang bisa dicari, dibaca, dan dipakai ulang oleh engineer, quantity surveyor, dan developer.
        </p>
        <div class="mt-9">
          <SearchLauncher examples={[{ label: 'Galian tanah', query: 'galian tanah' }, { label: '3.1.1', query: '3.1.1' }, { label: 'Bina Marga', query: 'Bina Marga' }]} client:load />
        </div>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted-foreground">
          <a class="inline-flex items-center gap-2 font-semibold text-foreground hover:text-primary" href="/katalog/">
            Buka katalog <ArrowRight aria-hidden="true" className="h-4 w-4" />
          </a>
          <a class="inline-flex items-center gap-2 hover:text-primary" href="/docs/">
            Mulai dari npm <Code2 aria-hidden="true" className="h-4 w-4" />
          </a>
        </div>
      </div>

      <div class="relative lg:pb-5">
        <div class="absolute -right-4 -top-12 hidden h-40 w-40 rounded-full border border-primary/20 lg:block"></div>
        <div class="relative rounded-[2rem] border border-foreground/15 bg-foreground p-6 text-background shadow-2xl shadow-primary/10 sm:p-8">
          <div class="flex items-start justify-between gap-6 border-b border-background/15 pb-6">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-background/55">catalog snapshot</p>
              <p class="mt-3 font-serif text-4xl">{catalog.items.length.toLocaleString('id-ID')}</p>
              <p class="mt-1 text-sm text-background/65">item AHSP siap dijelajahi</p>
            </div>
            <div class="grid h-11 w-11 place-items-center rounded-full border border-background/20 text-primary-foreground">
              <Database aria-hidden="true" className="h-5 w-5" />
            </div>
          </div>
          <div class="mt-6 grid grid-cols-2 gap-5 text-sm">
            <div>
              <p class="font-mono text-2xl text-background">{catalog.bundles.length}</p>
              <p class="mt-1 text-background/55">bundle regulasi</p>
            </div>
            <div>
              <p class="font-mono text-2xl text-background">{catalog.sourceItemCount.toLocaleString('id-ID')}</p>
              <p class="mt-1 text-background/55">baris sumber</p>
            </div>
          </div>
          <div class="mt-8 rounded-2xl border border-background/15 bg-background/5 p-4">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-background/55"><ShieldCheck aria-hidden="true" className="h-4 w-4" /> Provenance</div>
            <p class="mt-3 text-sm leading-6 text-background/80">Setiap item membawa bundle, regulasi, halaman sumber, dan tier verifikasi yang tersedia.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Kenapa AHS-ID</p>
        <h2 class="mt-4 max-w-md font-serif text-4xl leading-tight tracking-[-0.03em] sm:text-5xl">Dibuat untuk ditelusuri, bukan sekadar disalin.</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        <article class="border-t-2 border-primary pt-5">
          <Search aria-hidden="true" className="h-5 w-5 text-primary" />
          <h3 class="mt-5 font-semibold">Cari dengan konteks</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">Kode, nama pekerjaan, bidang, bundle, dan satuan tersedia dalam satu katalog.</p>
        </article>
        <article class="border-t-2 border-primary pt-5">
          <GitBranch aria-hidden="true" className="h-5 w-5 text-primary" />
          <h3 class="mt-5 font-semibold">Sumber tetap terlihat</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">Metadata regulasi dan provenance mengikuti item yang dikirim package data.</p>
        </article>
        <article class="border-t-2 border-primary pt-5">
          <Code2 aria-hidden="true" className="h-5 w-5 text-primary" />
          <h3 class="mt-5 font-semibold">Siap dipakai ulang</h3>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">Engine TypeScript, bundle JSON, dan dokumentasi terbuka untuk workflow berikutnya.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-border/80 bg-card/45">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
      <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Mulai dari item</p>
          <h2 class="mt-3 font-serif text-4xl tracking-[-0.03em] sm:text-5xl">Beberapa jalur kerja populer.</h2>
        </div>
        <a class="inline-flex items-center gap-2 text-sm font-semibold hover:text-primary" href="/katalog/">Lihat semua item <ArrowRight aria-hidden="true" className="h-4 w-4" /></a>
      </div>
      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {featured.map((item) => (
          <a class="group rounded-3xl border border-border bg-background p-6 transition-transform duration-200 hover:-translate-y-1 hover:border-primary/50 hover:shadow-xl hover:shadow-primary/5" href={catalogItemPath(item.bundleId, item.code)}>
            <div class="flex items-start justify-between gap-4">
              <span class="font-mono text-sm font-semibold text-primary">{item.code}</span>
              <Badge variant="muted">{item.unit}</Badge>
            </div>
            <h3 class="mt-8 min-h-16 font-serif text-2xl leading-tight">{item.name}</h3>
            <div class="mt-8 flex items-center justify-between border-t border-border/80 pt-4 text-xs text-muted-foreground">
              <span>{item.bundleName}</span>
              <ArrowRight aria-hidden="true" className="h-4 w-4 transition-transform group-hover:translate-x-1 group-hover:text-primary" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_.9fr] lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary">Untuk workflow engineer</p>
        <h2 class="mt-4 max-w-xl font-serif text-4xl leading-tight tracking-[-0.03em] sm:text-5xl">Dari bundle regulasi ke kalkulasi yang bisa diaudit.</h2>
        <p class="mt-6 max-w-xl text-base leading-7 text-muted-foreground">AHS-ID memisahkan engine, data AHSP, dan HSD regional sebagai package yang dapat dikomposisikan. Baca struktur data, jalankan kalkulasi, lalu ekspor hasilnya ke workflow Anda.</p>
        <div class="mt-8 grid gap-3 text-sm">
          <div class="flex items-center gap-3"><Check aria-hidden="true" className="h-5 w-5 text-primary" /> TypeScript strict dan branded types</div>
          <div class="flex items-center gap-3"><Check aria-hidden="true" className="h-5 w-5 text-primary" /> Validasi schema dan golden tests</div>
          <div class="flex items-center gap-3"><Check aria-hidden="true" className="h-5 w-5 text-primary" /> Data bundle terpisah dari engine</div>
        </div>
        <div class="mt-9 flex flex-wrap gap-3">
          <a class="inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90" href="/docs/">Baca quick start <ArrowRight aria-hidden="true" className="h-4 w-4" /></a>
          <a class="inline-flex min-h-10 items-center justify-center gap-2 whitespace-nowrap rounded-full border border-border bg-background px-4 py-2 text-sm font-semibold transition-colors hover:bg-muted" href="https://github.com/rachmad-jenss/ahs-id" rel="noreferrer">Lihat source <GitBranch aria-hidden="true" className="h-4 w-4" /></a>
        </div>
      </div>
      <div class="rounded-[2rem] bg-foreground p-5 text-background shadow-2xl shadow-primary/10 sm:p-7">
        <div class="flex items-center gap-2 text-xs font-mono text-background/55"><span class="h-2 w-2 rounded-full bg-primary"></span> npm quick start</div>
        <pre class="mt-6 overflow-x-auto text-sm leading-7 text-background/85"><code><span class="text-primary-foreground">import</span> {'{ createCalculator }'} <span class="text-primary-foreground">from</span> <span class="text-emerald-200">'@ahs-id/core'</span><br /><span class="text-primary-foreground">import</span> {'{ pupr2023 }'} <span class="text-primary-foreground">from</span> <span class="text-emerald-200">'@ahs-id/pupr-2023'</span><br /><br /><span class="text-primary-foreground">const</span> calculator = createCalculator(pupr2023, hsd)<br /><span class="text-primary-foreground">const</span> result = calculator.hitungHSP({'{'} kode: <span class="text-emerald-200">'3.1.1'</span>, volume: <span class="text-orange-200">100</span> {'}'})</code></pre>
        <div class="mt-6 flex items-center gap-2 border-t border-background/15 pt-5 text-xs text-background/55"><BookOpen aria-hidden="true" className="h-4 w-4" /> Dokumentasi berkembang bersama package</div>
      </div>
    </div>
  </section>

  <section class="bg-primary text-primary-foreground">
    <div class="mx-auto flex max-w-7xl flex-col gap-7 px-5 py-16 sm:flex-row sm:items-center sm:justify-between lg:px-8 lg:py-20">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary-foreground/65">Langkah berikutnya</p>
        <h2 class="mt-3 max-w-2xl font-serif text-4xl leading-tight tracking-[-0.03em] sm:text-5xl">Temukan item yang sedang Anda kerjakan.</h2>
      </div>
      <a class="inline-flex min-h-10 w-fit items-center justify-center gap-2 whitespace-nowrap rounded-full bg-primary-foreground px-5 py-3 text-sm font-semibold text-primary shadow-sm transition-colors hover:bg-primary-foreground/90" href="/katalog/">Buka katalog <ArrowRight aria-hidden="true" className="h-4 w-4" /></a>
    </div>
  </section>
</SiteLayout>
