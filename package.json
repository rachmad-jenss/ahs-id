{
  "name": "@ahs-id/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Open source AHSP calculation engine & data bundles for Indonesian construction cost estimation",
  "scripts": {
    "validate-data": "node scripts/validate-data.mjs",
    "validate-bundles": "node scripts/validate-bundles.mjs",
    "build": "node scripts/validate-data.mjs && turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
