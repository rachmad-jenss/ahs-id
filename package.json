{
  "name": "@ahs-id/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Open source AHSP calculation engine & data bundles for Indonesian construction cost estimation",
  "scripts": {
    "validate-data": "pnpm --filter @ahs-id/core build && node scripts/validate-data.mjs",
    "scrape:jakarta-hsp": "node scripts/scrape-bangun-jakarta-hsp.mjs",
    "build:jakarta-hsd": "node scripts/build-jakarta-hsd-from-hsp.mjs",
    "enrich:jakarta-hsp-manifest": "node scripts/enrich-jakarta-hsp-manifest.mjs",
    "build:ahsp-by-legal-source": "node scripts/build-ahsp-by-legal-source.mjs",
    "scrape:djbk-produk-hukum": "node scripts/scrape-djbk-produk-hukum-index.mjs",
    "merge:djbk-legal-catalog": "node scripts/merge-djbk-links-into-catalog.mjs",
    "refresh:national-legal-links": "node scripts/scrape-djbk-produk-hukum-index.mjs && node scripts/merge-djbk-links-into-catalog.mjs && node scripts/enrich-jakarta-hsp-manifest.mjs && node scripts/build-ahsp-by-legal-source.mjs",
    "download:national-legal-pdfs": "node scripts/download-national-legal-pdfs.mjs",
    "national:docling-auto": "node scripts/run-national-docling-auto.mjs",
    "national:se47-ahsp-chain": "node scripts/run-se47-ahsp-chain.mjs",
    "national:se47-coverage": "node scripts/run-se47-coverage.mjs --skip-extract",
    "national:se47-full-check": "node scripts/run-se47-full-check.mjs",
    "national:se47-validate-all": "node scripts/run-se47-validate-all.mjs",
    "national:se47-enrich-pages": "node scripts/run-se47-enrich-pages.mjs",
    "national:se47-patch-hsp-gaps": "node scripts/run-se47-patch-hsp-gaps.mjs",
    "national:se47-reextract-bm-gaps": "node scripts/run-se47-reextract-bm-gaps.mjs",
    "national:se47-enrich-gap-batches": "node scripts/run-se47-enrich-gap-batches.mjs",
    "validate-bundles": "node scripts/validate-bundles.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify": "node scripts/verify.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "pack-smoke": "node scripts/pack-smoke.mjs",
    "release": "node scripts/release.mjs",
    "build": "node scripts/validate-data.mjs && turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "node scripts/clean.mjs --all-workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
